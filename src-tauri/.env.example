# Google OAuth 2.0 credentials for Google Drive API
# Copy this file to .env and fill in your values.
# Get these from: https://console.cloud.google.com/apis/credentials
# → Click your Desktop app credential → Download JSON → copy client_id and client_secret
#
# NOTE: Desktop app credentials require client_secret for token exchange.
# It is "non-confidential" (safe to embed in app binary) but MUST be sent to Google.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id

# Firebase Web API key for the SAME project as GOOGLE_CLOUD_PROJECT_ID.
# Enable Google sign-in and deploy security/firestore.rules before release.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
